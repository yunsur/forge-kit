#!/usr/bin/env bash
# shellcheck disable=SC1090
# ─────────────────────────────────────────────────────────
# forge - AI 工具版本管理器
#
# 用法:
#   forge                   检查并提示更新
#   forge -a                检查并更新全部
#   forge download          只下载不解压
#   forge install           安装环境无关工具
#   forge start             加载环境（install 后、init 前）
#   forge init              初始化环境依赖工具+链接+npm包
#   forge init tools|bins|npm  单步初始化
#   forge list              显示所有工具状态
#   forge start             加载 AI 工作站环境
#   forge pack              打包用于迁移
#   forge update            仅检查可用更新
# ─────────────────────────────────────────────────────────
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"

# 加载模块
for f in "$ROOT_DIR/shell/forge"/*.sh; do
    [ -f "$f" ] || continue
    source "$f"
done

# ── 主入口 ───────────────────────────────────────────────

case "${1:-}" in
    -a|--all)       cmd_check "true" ;;
    download)       shift; cmd_download "$@" ;;
    install)        shift; cmd_install "$@" ;;
    init)           shift; cmd_init "$@" ;;
    uninstall)      shift; cmd_uninstall "$@" ;;
    list)           cmd_list ;;
    update)         cmd_check "false" ;;
    pack)           shift; cmd_pack "$@" ;;
    bundle)         shift; cmd_bundle "$@" ;;
    cleanup)        cmd_cleanup ;;
    info)           shift; cmd_info "$@" ;;
    start)          cmd_start ;;
    doctor)         cmd_doctor ;;
    help|--help|-h) show_help ;;
    "")             cmd_check "false" ;;
    *)              show_help; exit 1 ;;
esac
