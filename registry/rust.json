{
  "name": "rust",
  "desc": "Rust toolchain",
  "install_to": "$RUNTIMES_DIR/rust",
  "version_cmd": "curl -fsSL 'https://static.rust-lang.org/dist/channel-rust-stable.toml' 2>/dev/null | grep -F -A1 '[pkg.rust]' | awk -F'\"' '/version/{print $2}' | head -1 | cut -d' ' -f1",
  "arch": { "aarch64": "aarch64-unknown-linux-gnu" },
  "url": "https://static.rust-lang.org/dist/rust-{tag}-{arch}-unknown-linux-gnu.tar.xz",
  "format": "tar.xz",
  "strip": "strip1",
  "binaries": ["rustc/bin/rustc", "cargo/bin/cargo", "cargo/bin/rustup", "cargo/bin/rustfmt", "cargo/bin/cargo-clippy"]
}
